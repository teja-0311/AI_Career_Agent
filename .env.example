# Google Gemini API Key (Required for live Gemini chat, embeddings, and structured parsing)
GEMINI_API_KEY=your gemini_api_key_here
GOOGLE_API_KEY=your gemini_api_key_here

# Cryptographic JWT Secret & Authentication (Minimum 32 characters for HMAC-SHA256)
API_AUTH_SECRET=super_secret_career_agent_jwt_key_32chars_min!
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=120

# Runtime Environment ('production' enforces strict LangGraph checkpointer initialization; 'development' allows fallback)
ENVIRONMENT=development
ALLOW_FALLBACK_EXECUTOR=false

# Tavily Search API Key (Optional live external search prototype)
TAVILY_API_KEY=your tavily_api_key_here

# Explicit Model & Parser Backends
# RESUME_PARSER_BACKEND: 'gemini' (uses Gemini structured JSON extraction) or 'rule_based' (offline regex extractor)
RESUME_PARSER_BACKEND=rule_based
CHAT_MODEL=gemini-3.8-flash

# Explicit Embedding Backends
# EMBEDDING_BACKEND: 'gemini' (live Google text-embedding-004) or 'mock' (deterministic offline 768-dim hash vectors for local dev/testing)
EMBEDDING_BACKEND=gemini
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=3072

# Explicit Vector Database Backends
# VECTOR_STORE_BACKEND: 'chroma' (persistent ChromaDB with cosine distance) or 'memory' (in-memory persistent JSON vector store)
VECTOR_STORE_BACKEND=chroma
CHROMA_DIR=chroma_db
COLLECTION_NAME=job_postings

# Retrieval & 4-Way Hybrid Ranking Weights (Must be non-negative and sum > 0)
RETRIEVER_K=10
WEIGHT_SEMANTIC=0.45
WEIGHT_SKILLS=0.25
WEIGHT_EXPERIENCE=0.15
WEIGHT_LOCATION=0.15

# Persistent SQLite Memory & LangGraph Checkpointer
SQLITE_DB_PATH=career_agent_memory.db

# API & Security Settings
HOST=127.0.0.0
PORT=8000
DEBUG=false
UPLOAD_MAX_BYTES=10485760
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000
